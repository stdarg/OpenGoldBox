[preset.0]
name="macOS"
platform="macOS"
runnable=true
export_filter="all_resources"
include_filter="*.json"
exclude_filter="data/*,settings.cfg,settings.cfg.tmp"
export_path=""

[preset.0.options]
binary_format/architecture="universal"
application/product_name="OpenGoldBox"
application/bundle_identifier="org.opengoldbox.game"
application/short_version="@PROJECT_VERSION@"
application/version="@PROJECT_VERSION@"
application/min_macos_version_arm64="11.0"
application/min_macos_version_x86_64="11.0"
codesign/codesign=1
codesign/entitlements/disable_library_validation=true
privacy/documents_folder_usage_description="OpenGoldBox reads your copy of Pool of Radiance from the folder you choose."
privacy/desktop_folder_usage_description="OpenGoldBox reads your copy of Pool of Radiance from the folder you choose."
privacy/downloads_folder_usage_description="OpenGoldBox reads your copy of Pool of Radiance from the folder you choose."
privacy/removable_volumes_usage_description="OpenGoldBox reads your copy of Pool of Radiance from the folder you choose."
privacy/network_volumes_usage_description="OpenGoldBox reads your copy of Pool of Radiance from the folder you choose."

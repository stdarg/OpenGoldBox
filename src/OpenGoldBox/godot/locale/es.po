#: src/OpenGoldBox/character_sheet_view.cpp:224
#. Preserve {named} placeholders and any [BBCode] tags; values may be reordered.
msgid "+0 proficiency: {class} does not grant proficiency in this save."
msgstr "+0 por competencia: la clase {class} no otorga competencia en esta salvación."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "+1 AC while wearing armor."
msgstr "+1 a la CA mientras llevas armadura."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:29806 src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "+1 AC while wearing armor. Requires the Fighting Style feature."
msgstr "+1 a la CA al llevar armadura. Requiere el rasgo Estilo de combate."

#: src/OpenGold.Rules.Srd5/src/effect_labels.h:79
msgid "+1 to Armor Class and saving throws and Resistance to all damage; the caster takes the same damage."
msgstr "+1 a la Clase de Armadura y a las tiradas de salvación y resistencia a todo el daño; el lanzador recibe el mismo daño."

#: src/OpenGold.Rules.Srd5/src/effect_labels.h:135
msgid "+1 to its spell save DC and Advantage on spell attack rolls."
msgstr "+1 a su CD de salvación de conjuros y ventaja en las tiradas de ataque de conjuro."

#: src/OpenGold.Rules.Srd5/src/effect_labels.h:43
msgid "+2 to Armor Class."
msgstr "+2 a la Clase de Armadura."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "+2 to attack rolls with Ranged weapons."
msgstr "+2 a las tiradas de ataque con armas a distancia."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:29813
msgid "+2 to attack rolls with Ranged weapons. Requires Fighting Style."
msgstr "+2 a las tiradas de ataque con armas a distancia. Requiere Estilo de combate."

#: src/OpenGold.Rules.Srd5/src/effect_labels.h:105
msgid "+5 to Armor Class, and Magic Missile deals it no damage."
msgstr "+5 a la Clase de Armadura, y Proyectil mágico no le inflige daño."

#: src/OpenGold.Rules.Srd5/src/effect_labels.h:54
#. Preserve {named} placeholders and any [BBCode] tags; values may be reordered.
msgid "+{value} to attack rolls with Melee weapons, which may deal Radiant damage."
msgstr "+{value} a las tiradas de ataque con armas cuerpo a cuerpo, que pueden infligir daño Radiante."

#: src/OpenGold.Rules.Srd5/src/effect_labels.h:115
#. Preserve {named} placeholders and any [BBCode] tags; values may be reordered.
msgid "+{value} to weapon attack and damage rolls."
msgstr "+{value} a las tiradas de ataque y de daño con armas."

#: src/OpenGold.Rules.Srd5/src/effect_labels.h:238
#. Preserve {named} placeholders and any [BBCode] tags; values may be reordered.
msgid "-{value} to D20 Tests; the penalty drops by 1 after each Long Rest."
msgstr "-{value} a las pruebas de d20; la penalización baja 1 tras cada Descanso largo."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: a spell that can take more creatures from a higher slot takes one more."
msgstr "1 punto de hechicería: un conjuro que puede afectar a más criaturas con un espacio superior afecta a una más."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: allies in your save spell's area succeed and take no half damage."
msgstr "1 punto de hechicería: los aliados en el área de tu conjuro con salvación la superan y no reciben la mitad del daño."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: change Acid, Cold, Fire, Lightning, Poison or Thunder damage to another of them."
msgstr "1 punto de hechicería: cambia el daño de ácido, frío, fuego, relámpago, veneno o trueno a otro de ellos."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: double a Concentration spell's duration and gain Advantage to keep it."
msgstr "1 punto de hechicería: duplica la duración de un conjuro de concentración y obtén ventaja para mantenerlo."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: double a spell's range, or Touch becomes 30 feet."
msgstr "1 punto de hechicería: duplica el alcance de un conjuro, o el toque pasa a 30 pies."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: reroll a missed spell attack roll."
msgstr "1 punto de hechicería: repite una tirada de ataque de conjuro fallida."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: reroll your lowest damage dice, up to your Charisma modifier."
msgstr "1 punto de hechicería: repite tus dados de daño más bajos, hasta tu modificador de Carisma."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "2 Sorcery Points: cast an Action spell as a Bonus Action."
msgstr "2 puntos de hechicería: lanza un conjuro de acción como acción adicional."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "2 Sorcery Points: one target has Disadvantage on its save against the spell."
msgstr "2 puntos de hechicería: un objetivo tiene desventaja en su salvación contra el conjuro."

#: src/OpenGoldBox/godot/scenes/character_creation.tscn:302
msgid "< Body"
msgstr "< Cuerpo"

#: src/OpenGoldBox/godot/scenes/character_creation.tscn:278
msgid "< Head"
msgstr "< Cabeza"

#: src/OpenGold.Rules.Srd5/src/effect_labels.h:351
msgid "A Construct copy with half the original's Hit Points, healed only by repair."
msgstr "Una copia constructo con la mitad de los puntos de golpe del original, que solo se cura con reparaciones."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:18798
#. Preserve {named} placeholders and any [BBCode] tags; values may be reordered.
msgid "A Draconic Spirit answers {name}."
msgstr "Un espíritu dracónico acude a la llamada de {name}."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:18538
msgid "A Guardian of Faith appears."
msgstr "Aparece un Guardián de la fe."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A Rogue carrying it can poison a foe with Cunning Strike."
msgstr "Un pícaro que los lleve puede envenenar a un enemigo con Golpe astuto."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A Rogue carrying them has twice the chance to pick a lock."
msgstr "Un pícaro que las lleve tiene el doble de probabilidad de forzar una cerradura."

#: src/OpenGold.Rules.Srd5/src/effect_labels.h:103 src/OpenGold.Rules.Srd5/src/effect_labels.h:63
msgid "A Strength (Athletics) check breaks free."
msgstr "Una prueba de Fuerza (Atletismo) lo libera."

#: src/OpenGold.Rules.Srd5/src/effect_labels.h:98
msgid "A Wisdom save at the end of each of its turns ends it, and so may one with Advantage whenever it takes damage."
msgstr "Una salvación de Sabiduría al final de cada uno de sus turnos lo termina, y también puede hacerlo una con ventaja cada vez que recibe daño."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A Wizard cantrip of your choice."
msgstr "Un truco de mago a tu elección."

#: src/OpenGold.Rules.Srd5/src/effect_labels.h:230
msgid "A Zombie that obeys the creature that raised it."
msgstr "Un zombi que obedece a la criatura que lo alzó."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A blast invocation needs the cantrip it improves."
msgstr "Una invocación de descarga necesita el truco que mejora."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A bottle writes a spell of its level or lower on a scroll, or copies one from a scroll into a Wizard's spellbook."
msgstr "Un frasco escribe en un pergamino un conjuro de su nivel o inferior, o copia uno de un pergamino en el libro de conjuros de un mago."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:19016
msgid "A box of force closes."
msgstr "Se cierra una caja de fuerza."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:19020
msgid "A cage of force closes."
msgstr "Se cierra una jaula de fuerza."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A creature at 0 Hit Points within 15 feet becomes Stable."
msgstr "Una criatura con 0 puntos de golpe a 15 pies o menos queda estable."

#: src/OpenGold.Rules.Srd5/src/effect_labels.h:76
msgid "A creature that attacks it or harms it with a spell must make a Wisdom save or lose the attack."
msgstr "Una criatura que lo ataque o lo dañe con un conjuro debe hacer una salvación de Sabiduría o pierde el ataque."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A creature that hits you has Disadvantage on its other attacks against you this turn."
msgstr "Una criatura que te impacta tiene desventaja en sus demás ataques contra ti este turno."

#: src/OpenGoldBox/monster_ability_options.h:54
msgid "A different last attack"
msgstr "Un último ataque distinto"

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:78
msgid "A disciplined martial artist. Primary abilities: Dexterity and Wisdom. Hit Die: d8."
msgstr "Un artista marcial disciplinado. Características principales: Destreza y Sabiduría. Dado de golpe: d8."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A divine scroll: a Cleric, Druid, Paladin or Ranger reads its spells. A level-13 Thief reads any scroll."
msgstr "Un pergamino divino: un clérigo, druida, paladín o explorador lee sus conjuros. Un ladrón de nivel 13 lee cualquier pergamino."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A feat or ability points."
msgstr "Una dote o puntos de característica."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A feat or ability points.\nA fifth Rage."
msgstr "Una dote o puntos de característica.\nUna quinta Furia."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A feat or ability points.\nOne more Eldritch Invocation; Devouring Blade is open to Thirsting Blade."
msgstr "Una dote o puntos de característica.\nUna invocación sobrenatural más; Hoja devoradora se abre a Hoja sedienta."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A feat or ability points.\nWild Shape: the Tiger."
msgstr "Una dote o puntos de característica.\nForma salvaje: el tigre."

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:68
msgid "A fierce warrior. Primary ability: Strength. Hit Die: d12."
msgstr "Un combatiente feroz. Característica principal: Fuerza. Dado de golpe: d12."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:18662
#. Preserve {named} placeholders and any [BBCode] tags; values may be reordered.
msgid "A giant insect answers {name}."
msgstr "Un insecto gigante responde a {name}."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:19002
msgid "A glowing bead hangs in the air."
msgstr "Una perla brillante flota en el aire."

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:74
msgid "A guardian of nature. Primary ability: Wisdom. Hit Die: d8."
msgstr "Un guardián de la naturaleza. Característica principal: Sabiduría. Dado de golpe: d8."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:18727
msgid "A hand of shimmering force appears."
msgstr "Aparece una mano de fuerza reluciente."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A hit with the cantrip pushes a Large or smaller creature 10 feet away."
msgstr "Un impacto del truco empuja 10 pies a una criatura Grande o menor."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:9411
#. Preserve {named} placeholders and any [BBCode] tags; values may be reordered.
msgid "A holy aura shines around {name}."
msgstr "Un aura sagrada brilla alrededor de {name}."

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:82
msgid "A hunter and wilderness explorer. Primary abilities: Dexterity and Wisdom. Hit Die: d10."
msgstr "Un cazador y explorador de tierras salvajes. Características principales: Destreza y Sabiduría. Dado de golpe: d10."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 4 spell slot and Paladin spells: Aura of Life, Banishment and Death Ward. Oath of Devotion: Freedom of Movement and Guardian of Faith are always prepared.\nProficiency Bonus +5."
msgstr "Un espacio de conjuro de nivel 4 y conjuros de paladín: Aura de vida, Destierro y Custodia contra la muerte. Juramento de devoción: Libertad de movimiento y Guardián de la fe siempre están preparados.\nBonificador por competencia +5."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 4 spell slot and Wizard spells: Banishment, Black Tentacles, Blight, Charm Monster, Confusion, Dimension Door, Fire Shield, Greater Invisibility, Ice Storm, Phantasmal Killer, Polymorph, Resilient Sphere, Stoneskin, Vitriolic Sphere and Wall of Fire."
msgstr "Un espacio de conjuro de nivel 4 y conjuros de mago: Destierro, Tentáculos negros, Plaga, Hechizar monstruo, Confusión, Puerta dimensional, Escudo de fuego, Invisibilidad mayor, Tormenta de hielo, Asesino fantasmal, Polimorfar, Esfera resistente, Piel pétrea, Esfera vitriólica y Muro de fuego."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 5 spell slot and Druid spells: Antilife Shell, Cone of Cold, Conjure Elemental, Contagion, Greater Restoration, Insect Plague, Mass Cure Wounds, Reincarnate and Wall of Stone; your land's next Circle Spell.\nProficiency Bonus +4."
msgstr "Un espacio de conjuro de nivel 5 y conjuros de druida: Caparazón antivida, Cono de frío, Conjurar elemental, Contagio, Restablecimiento mayor, Plaga de insectos, Curar heridas en masa, Reencarnación y Muro de piedra; el siguiente conjuro de círculo de tu tierra.\nBonificador por competencia +4."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 5 spell slot and Sorcerer spells: Animate Objects, Arcane Hand, Cloudkill, Cone of Cold, Dominate Person, Hold Monster, Insect Plague, Telekinesis and Wall of Stone; Draconic Spells: Summon Dragon is always prepared. Font of Magic creates level-5 slots.\nProficiency Bonus +4."
msgstr "Un espacio de conjuro de nivel 5 y conjuros de hechicero: Animar objetos, Mano arcana, Nube aniquiladora, Cono de frío, Dominar persona, Inmovilizar monstruo, Plaga de insectos, Telequinesis y Muro de piedra; Conjuros dracónicos: Invocar dragón siempre está preparado. Fuente de magia crea espacios de nivel 5.\nBonificador por competencia +4."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 5 spell slot and Wizard spells: Animate Objects, Arcane Hand, Cloudkill, Cone of Cold, Conjure Elemental, Dominate Person, Hold Monster, Mislead, Summon Dragon, Telekinesis, Wall of Force and Wall of Stone.\nProficiency Bonus +4."
msgstr "Un espacio de conjuro de nivel 5 y conjuros de mago: Animar objetos, Mano arcana, Nube aniquiladora, Cono de frío, Conjurar elemental, Dominar persona, Inmovilizar monstruo, Engañar, Invocar dragón, Telequinesis, Muro de fuerza y Muro de piedra.\nBonificador por competencia +4."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 6 spell slot and Bard spells: Eyebite, Heroes' Feast, Irresistible Dance and True Seeing."
msgstr "Un espacio de conjuro de nivel 6 y conjuros de bardo: Mal de ojo, Festín de héroes, Danza irresistible y Visión verdadera."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 6 spell slot and Cleric spells: Blade Barrier, Create Undead, Harm, Heal, Heroes' Feast, Sunbeam, True Seeing and Word of Recall.\nCantrips deal more damage."
msgstr "Un espacio de conjuro de nivel 6 y conjuros de clérigo: Barrera de cuchillas, Crear muertos vivientes, Dañar, Sanar, Festín de héroes, Rayo de sol, Visión verdadera y Palabra de regreso.\nLos trucos infligen más daño."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 6 spell slot and Druid spells: Conjure Fey, Flesh to Stone, Heal, Heroes' Feast, Sunbeam and Wall of Thorns."
msgstr "Un espacio de conjuro de nivel 6 y conjuros de druida: Conjurar feérico, Carne a piedra, Sanar, Festín de héroes, Rayo de sol y Muro de espinas."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 6 spell slot and Sorcerer spells: Chain Lightning, Circle of Death, Disintegrate, Eyebite, Flesh to Stone, Freezing Sphere, Globe of Invulnerability, Sunbeam and True Seeing."
msgstr "Un espacio de conjuro de nivel 6 y conjuros de hechicero: Relámpago en cadena, Círculo de muerte, Desintegrar, Mal de ojo, Carne a piedra, Esfera congelante, Globo de invulnerabilidad, Rayo de sol y Visión verdadera."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 6 spell slot and Wizard spells: Chain Lightning, Circle of Death, Contingency, Create Undead, Disintegrate, Eyebite, Flesh to Stone, Freezing Sphere, Globe of Invulnerability, Irresistible Dance, Magic Jar, Sunbeam, True Seeing and Wall of Ice."
msgstr "Un espacio de conjuro de nivel 6 y conjuros de mago: Relámpago en cadena, Círculo de muerte, Contingencia, Crear muertos vivientes, Desintegrar, Mal de ojo, Carne a piedra, Esfera congelante, Globo de invulnerabilidad, Danza irresistible, Recipiente mágico, Rayo de sol, Visión verdadera y Muro de hielo."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 7 spell slot and Bard spells: Arcane Sword, Forcecage, Prismatic Spray, Regenerate and Resurrection.\nProficiency Bonus +5."
msgstr "Un espacio de conjuro de nivel 7 y conjuros de bardo: Espada arcana, Jaula de fuerza, Rociada prismática, Regenerar y Resurrección.\nBonificador por competencia +5."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 7 spell slot and Cleric spells: Conjure Celestial, Divine Word, Fire Storm, Regenerate and Resurrection.\nDivine Spark rolls 3d8."
msgstr "Un espacio de conjuro de nivel 7 y conjuros de clérigo: Conjurar celestial, Palabra divina, Tormenta de fuego, Regenerar y Resurrección.\nChispa divina tira 3d8."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 7 spell slot and Druid spells: Fire Storm, Regenerate and Reverse Gravity.\nProficiency Bonus +5."
msgstr "Un espacio de conjuro de nivel 7 y conjuros de druida: Tormenta de fuego, Regenerar e Invertir la gravedad.\nBonificador por competencia +5."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 7 spell slot and Sorcerer spells: Delayed Blast Fireball, Finger of Death, Fire Storm, Prismatic Spray and Reverse Gravity."
msgstr "Un espacio de conjuro de nivel 7 y conjuros de hechicero: Bola de fuego de explosión retardada, Dedo de la muerte, Tormenta de fuego, Rociada prismática e Invertir la gravedad."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 7 spell slot and Wizard spells: Arcane Sword, Delayed Blast Fireball, Finger of Death, Forcecage, Prismatic Spray, Reverse Gravity and Simulacrum."
msgstr "Un espacio de conjuro de nivel 7 y conjuros de mago: Espada arcana, Bola de fuego de explosión retardada, Dedo de la muerte, Jaula de fuerza, Rociada prismática, Invertir la gravedad y Simulacro."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 8 spell slot and Bard spells: Befuddlement, Dominate Monster, Mind Blank and Power Word Stun.\nThe Bardic Inspiration die is a d12."
msgstr "Un espacio de conjuro de nivel 8 y conjuros de bardo: Embotamiento mental, Dominar monstruo, Mente en blanco y Palabra de poder: aturdir.\nEl dado de Inspiración bárdica es un d12."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 8 spell slot and Cleric spells: Antimagic Field, Earthquake, Holy Aura and Sunburst."
msgstr "Un espacio de conjuro de nivel 8 y conjuros de clérigo: Campo antimagia, Terremoto, Aura sagrada y Estallido solar."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 8 spell slot and Druid spells: Befuddlement, Earthquake, Incendiary Cloud, Sunburst and Tsunami.\nImproved Elemental Fury: Primal Strike deals 2d8."
msgstr "Un espacio de conjuro de nivel 8 y conjuros de druida: Embotamiento mental, Terremoto, Nube incendiaria, Estallido solar y Tsunami.\nFuria elemental mejorada: Golpe primigenio hace 2d8."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 8 spell slot and Sorcerer spells: Dominate Monster, Earthquake, Incendiary Cloud, Power Word Stun and Sunburst."
msgstr "Un espacio de conjuro de nivel 8 y conjuros de hechicero: Dominar monstruo, Terremoto, Nube incendiaria, Palabra de poder: aturdir y Estallido solar."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "A level 8 spell slot and Wizard spells: Antimagic Field, Befuddlement, Dominate Monster, Incendiary Cloud, Maze, Mind Blank, Power Word Stun and Sunburst."
msgstr "Un espacio de conjuro de nivel 8 y conjuros de mago: Campo antimagia, Embotamiento mental, Dominar monstruo, Nube incendiaria, Laberinto, Mente en blanco, Palabra de poder: aturdir y Estallido solar."

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:76
msgid "A master of weapons. Primary ability: Strength or Dexterity. Hit Die: d10."
msgstr "Un maestro de las armas. Característica principal: Fuerza o Destreza. Dado de golpe: d10."

#: src/OpenGoldBox/training_control.h:193
msgid "A miss still deals damage equal to the ability modifier used for the attack."
msgstr "Un fallo inflige igualmente daño igual al modificador de característica usado en el ataque."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:18550
msgid "A pack of spirit animals appears."
msgstr "Aparece una manada de animales espirituales."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:18917
msgid "A phantom watchdog appears."
msgstr "Aparece un perro guardián fantasmal."

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:90
msgid "A scholar of arcane magic. Primary ability: Intelligence. Hit Die: d6."
msgstr "Un estudioso de la magia arcana. Característica principal: Inteligencia. Dado de golpe: d6."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:9064
#. Preserve {named} placeholders and any [BBCode] tags; values may be reordered.

[gd_scene format=3]

[node name="CastPanel" type="PanelContainer"]
theme_type_variation = &"PanelInventory"
z_index = 2
mouse_filter = 0

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_type_variation = &"Margin20"

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_type_variation = &"VBoxContainerGap10"

[node name="Header" type="Label" parent="Margin/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_type_variation = &"LabelText20"

[node name="Action" type="OptionButton" parent="Margin/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2

[node name="Target" type="OptionButton" parent="Margin/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2

[node name="Status" type="Label" parent="Margin/Rows"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
autowrap_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Margin/Rows"]
layout_mode = 2
theme_type_variation = &"HBoxContainerGap16"

[node name="Close" type="Button" parent="Margin/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 36)
layout_mode = 2
text = "Close"

[node name="Use" type="Button" parent="Margin/Rows/Buttons"]
unique_name_in_owner = true

[node name="Choice" type="HBoxContainer" parent="Margin/Columns/Main"]
custom_minimum_size = Vector2(0, 30)
theme_override_constants/separation = 6

[node name="Question" type="Label" parent="Margin/Columns/Main/Choice"]

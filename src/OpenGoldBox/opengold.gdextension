[configuration]
entry_symbol = "opengold_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
windows.x86_64 = "res://bin/opengoldbox_game.dll"
linux.x86_64 = "res://bin/opengoldbox_game.so"
linux.arm64 = "res://bin/opengoldbox_game.so"
macos = "res://bin/opengoldbox_game.dylib"

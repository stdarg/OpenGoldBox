saves ogre 4 -1 3 -3 -2 -2
saves troll 4 1 5 -2 -1 -2
saves slums-magic-user -1 2 1 5 3 0
damage_types slums-hobgoblin slashing piercing
damage_types ogre bludgeoning piercing
damage_types troll slashing slashing
damage_types slums-magic-user piercing piercing
size ogre large
size troll large
type slums-hobgoblin fey
type ogre giant
type troll giant
pack_tactics slums-hobgoblin
# ranged_extra_damage creature count sides type: damage a ranged hit adds.
ranged_extra_damage slums-hobgoblin 3 4 poison
# regeneration creature hit_points (stopped by Acid or Fire). Melee reaches
# adjacent squares only (MELEE-1), so the Troll's 10-foot reach is not used.
regeneration troll 15
multiattack troll 3
# perception creature bonus: the Perception skill of a stat block that has it
# (Passive Perception is 10 + bonus); others use their Wisdom save (HIDE-1).
perception scout 5
perception lizardfolk 3
perception troll 5
perception norris-the-gray 0
perception slums-magic-user 1
